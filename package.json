{
  "name": "ak-scan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node workflow/scripts/sync-runtime-assets.mjs",
    "dev": "next dev",
    "prebuild": "node workflow/scripts/sync-runtime-assets.mjs",
    "build": "next build",
    "postbuild": "node workflow/scripts/postbuild.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "headers:sync": "tsx workflow/scripts/host-headers.ts",
    "test:scan": "tsx workflow/scripts/test-scan-logic.ts",
    "test:import-session": "tsx workflow/scripts/test-import-session.ts",
    "test:ocr": "tsx workflow/scripts/test-ocr.ts",
    "test:ocr-accuracy": "tsx workflow/scripts/test-ocr-accuracy.ts",
    "test:pdf-layout": "tsx workflow/scripts/test-pdf-layout.ts",
    "test:export": "tsx workflow/scripts/test-export.ts",
    "test:security": "tsx workflow/scripts/test-security.ts",
    "test": "npm run test:scan && npm run test:import-session && npm run test:security && npm run test:ocr && npm run test:pdf-layout && npm run test:export && npm run test:ocr-accuracy",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
