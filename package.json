    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
